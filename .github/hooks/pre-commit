#!/bin/bash
# Pre-commit hook to ensure code quality

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🐦 Running pre-commit checks...${NC}\n"

# Check if Node.js is available
if ! command -v node &> /dev/null; then
    echo -e "${RED}❌ Node.js is not installed${NC}"
    exit 1
fi

# Run linting
echo -e "${YELLOW}Checking code quality...${NC}"
if pnpm lint &> /dev/null; then
    echo -e "${GREEN}✓ Linting passed${NC}"
else
    echo -e "${RED}✗ Linting failed. Fix errors before committing.${NC}"
    pnpm lint
    exit 1
fi

# Run TypeScript check
echo -e "${YELLOW}Checking TypeScript...${NC}"
if pnpm typecheck &> /dev/null; then
    echo -e "${GREEN}✓ TypeScript check passed${NC}"
else
    echo -e "${RED}✗ TypeScript check failed${NC}"
    pnpm typecheck
    exit 1
fi

# Format code
echo -e "${YELLOW}Formatting code...${NC}"
pnpm format

# Add formatted files
git add -A

echo -e "${GREEN}✓ All checks passed!${NC}\n"
echo -e "${YELLOW}Ready to commit! 🚀${NC}"
