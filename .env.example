# ═══════════════════════════════════════════════════
# Bluebird Online — Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env.local (dev) or use your vault (prod)
# NEVER commit actual secrets to Git

# ─── App Configuration ───
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001

# ─── Database ───
POSTGRES_USER=bluebird
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bluebird
DATABASE_URL=postgresql://bluebird:change_me_in_production@localhost:5432/bluebird

# ─── Redis ───
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379

# ─── Authentication ───
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=bluebird-online
JWT_AUDIENCE=bluebird-customers

# ─── Encryption ───
# For MikroTik credentials and sensitive data
MIKROTIK_ENCRYPTION_KEY=your_32_byte_encryption_key_here
DATA_ENCRYPTION_KEY=your_32_byte_data_encryption_key_here

# ─── Bangladesh Payment Gateways ───
# SSLCommerz
SSLCOMMERZ_STORE_ID=teststore
SSLCOMMERZ_STORE_PASS=testpass
SSLCOMMERZ_IS_SANDBOX=true

# bKash
BKASH_APP_KEY=test_app_key
BKASH_APP_SECRET=test_app_secret
BKASH_USERNAME=test_user
BKASH_PASSWORD=test_pass
BKASH_IS_SANDBOX=true

# Nagad
NAGAD_MERCHANT_ID=test_merchant
NAGAD_MERCHANT_PRIVATE_KEY=test_key
NAGAD_IS_SANDBOX=true

# ─── SMS Gateway (Bangladesh) ───
SMS_GATEWAY_API_KEY=test_sms_key
SMS_GATEWAY_SECRET=test_sms_secret
SMS_GATEWAY_PROVIDER=sslwireless  # or: grameenphone, robi, banglalink

# ─── Email ───
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=noreply@bluebird.online
EMAIL_PASS=app_specific_password
EMAIL_FROM_NAME="Bluebird Online"
EMAIL_FROM_ADDRESS=noreply@bluebird.online

# ─── Telegram Bot ───
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# ─── WhatsApp Business API ───
WHATSAPP_API_KEY=test_whatsapp_key
WHATSAPP_PHONE_NUMBER_ID=123456789

# ─── MikroTik ───
MIKROTIK_DEFAULT_API_PORT=8728
MIKROTIK_DEFAULT_SSH_PORT=22
MIKROTIK_CONNECTION_TIMEOUT=10000
MIKROTIK_MAX_RETRIES=3

# ─── Monitoring ───
SNMP_COMMUNITY=public
OLT_POLL_INTERVAL_MS=30000
ONU_SIGNAL_THRESHOLD_DBM=-25
FAULT_ALERT_COOLDOWN_MS=300000

# ─── AI Assistant ───
OPENAI_API_KEY=sk-test-key
AI_ASSISTANT_MODEL=gpt-4o
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.7

# ─── Feature Flags ───
NEXT_PUBLIC_FEATURE_AI_ASSISTANT=false
NEXT_PUBLIC_FEATURE_SPEED_TEST=true
NEXT_PUBLIC_FEATURE_SELF_ROUTER_REBOOT=true

# ─── Security ───
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging ───
LOG_LEVEL=debug  # debug, info, warn, error
SENTRY_DSN=
