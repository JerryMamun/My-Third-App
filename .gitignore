# .gitignore for Bluebird Online Monorepo

# Dependencies
node_modules/
pnpm-lock.yaml
yarn.lock
package-lock.json

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
.env.test.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml
.project
.classpath
.c9/
*.sublime-workspace

# OS
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
._*

# Testing
coverage/
.nyc_output/
jest-coverage/
*.lcov
.coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temporary files
tmp/
temp/
.tmp/
*.tmp

# Cache
.cache/
.eslintcache
.stylelintcache
.prettierignore

# Database
*.sqlite
*.sqlite3
*.db

# Docker
.dockerignore

# Generated files
generated/
*.generated.ts
*.gen.ts

# Prisma
prisma/migrations/dev_*

# Documentation
docs/generated/

# Archives
*.zip
*.tar.gz
*.rar

# Large files
*.psd
*.mov
*.mp4

# secrets
secrets.json
.secrets/

# Misc
.turboignore
